# ─── Public (inlined into the browser bundle) ────────────────────────────────
# CometChat dashboard → your app → Credentials / "API & Auth Keys"
NEXT_PUBLIC_COMETCHAT_APP_ID=
# us | eu | in
NEXT_PUBLIC_COMETCHAT_REGION=

# ─── SERVER ONLY: never prefix these with NEXT_PUBLIC_ ───────────────────────
# Auth Key (authOnly scope). Optional and unused in production: the app logs
# users in with server-minted Auth Tokens instead. Kept for local experiments.
COMETCHAT_AUTH_KEY=
# REST API Key (fullAccess scope). Dashboard → API & Auth Keys → REST API Keys.
# Used to create users, mint auth tokens, manage room groups, send bot messages.
COMETCHAT_REST_API_KEY=

# 32+ random characters. Signs player sessions, derives the bot pool UIDs and
# the per-round commitment salt.  Generate: openssl rand -hex 32
SESSION_SECRET=

# LLM for the bots: gemini | groq
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Optional. Defaults: gemini → gemini-3.5-flash-lite, groq → llama-3.3-70b-versatile
LLM_MODEL=
